{
  "$schema": "https://json.schemastore.org/expo-58.0.0.json",
  "expo": {
    "name": "ClyvoPredict",
    "slug": "ClyvoPredict",
    "owner": "gabilandim",
    "extra": {
      "eas": {
        "projectId": "0f2c7357-652e-4bd3-8988-e30d4a94337e"
      }
    },
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "br.com.fiap.clyvopredict"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "br.com.fiap.clyvopredict",
      "versionCode": 1
    },
    "web": {},
    "plugins": [
      [
        "expo-notifications",
        {
          "color": "#289fce"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ]
  }
}
