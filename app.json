{
  "$schema": "https://json.schemastore.org/expo-58.0.0.json",
  "expo": {
    "name": "ClyvoPredict",
    "slug": "ClyvoPredict",
    "owner": "gabilandim",
    "extra": {
      "eas": {
        "projectId": "0f2c7357-652e-4bd3-8988-e30d4a94337e"
      }
    },
    "version": "1.0.2",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "br.com.fiap.clyvopredict"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "br.com.fiap.clyvopredict",
      "versionCode": 3
    },
    "web": {},
    "plugins": [
      [
        "expo-notifications",
        {
          "color": "#289fce"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true,
            "targetSdkVersion": 34
          }
        }
      ],
      [
        "expo-font",
        {
          "android": {
            "fonts": [
              {
                "fontFamily": "ClyvoRoboto",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/Roboto_400Regular.ttf",
                    "weight": 400
                  },
                  {
                    "path": "./assets/fonts/Roboto_400Regular_Italic.ttf",
                    "weight": 400,
                    "style": "italic"
                  },
                  {
                    "path": "./assets/fonts/Roboto_500Medium.ttf",
                    "weight": 500
                  },
                  {
                    "path": "./assets/fonts/Roboto_600SemiBold.ttf",
                    "weight": 600
                  },
                  {
                    "path": "./assets/fonts/Roboto_700Bold.ttf",
                    "weight": 700
                  },
                  {
                    "path": "./assets/fonts/Roboto_800ExtraBold.ttf",
                    "weight": 800
                  }
                ]
              }
            ]
          }
        }
      ]
    ]
  }
}
